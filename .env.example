# =============================================================================
# ZenSocial — Environment Variables
# Copy this file to .env.local for local development.
# Add every key below as an Environment Variable in your Vercel project.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (Hostinger MySQL)
# ─────────────────────────────────────────────────────────────────────────────
# Hostinger → Hosting → Databases → MySQL Databases → Details
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME?ssl=true&sslaccept=strict
DATABASE_URL="mysql://db_user:db_password@srv123.hostinger.com:3306/u123456789_zen?ssl=true&sslaccept=strict"

# ─────────────────────────────────────────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"
# Your canonical production URL (no trailing slash)
NEXTAUTH_URL="https://yourdomain.com"

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDINARY
# ─────────────────────────────────────────────────────────────────────────────
# console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your-api-secret"
# Used by the upload-sign API to validate Cloudinary webhook callbacks
CLOUDINARY_WEBHOOK_SECRET="your-webhook-secret"

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL  (Resend — https://resend.com)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="ZenSocial <noreply@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────────
# SEED — first-run admin account
# Set these BEFORE first deploy. The seed upserts this account on every build
# but never overwrites an existing password (update: {} is a no-op).
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeMe!SuperSecure2024"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="production"
